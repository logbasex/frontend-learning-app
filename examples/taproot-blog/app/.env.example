# Local Postgres — `docker run --name taproot-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taproot?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Public env (shipped to the browser)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Taproot"
